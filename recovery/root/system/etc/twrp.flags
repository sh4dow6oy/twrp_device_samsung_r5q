# mount point	fstype		device			device2			flags

# Dynamic Partitions
/system         auto    system                                          flags=display="System";backup=1;logical;first_stage_mount
/vendor         auto    vendor                                          flags=display="Vendor";backup=1;logical;first_stage_mount
/product        auto    product                                         flags=display="Product";backup=1;logical;first_stage_mount
/odm            auto    odm                                             flags=display="ODM";backup=1;logical;first_stage_mount

# Flashable Images
/system_image   emmc    /dev/block/mapper/system                        flags=display="System Image";backup=1;flashimg=1;logical
/vendor_image   emmc    /dev/block/mapper/vendor                        flags=display="Vendor Image";backup=1;flashimg=1;logical
/product_image  emmc    /dev/block/mapper/product                       flags=display="Product Image";backup=1;flashimg=1;logical
/odm_image      emmc    /dev/block/mapper/odm                           flags=display="ODM Image";backup=1;flashimg=1;logical

/boot		emmc		/dev/block/bootdevice/by-name/boot		flags=backup=1;flashimg=1;display="Boot"
/dtbo		emmc		/dev/block/bootdevice/by-name/dtbo		flags=backup=1;flashimg=1;display="Dtbo"
/recovery	emmc		/dev/block/bootdevice/by-name/recovery		flags=backup=1;flashimg=1;display="Recovery"

/modem         vfat   /dev/block/bootdevice/by-name/modem
/firmware      vfat   /dev/block/bootdevice/by-name/apnhlos                   flags=display="Firmware";fsflags=ro

/cache         ext4		/dev/block/bootdevice/by-name/cache
/mnt/vendor/efs		ext4		/dev/block/bootdevice/by-name/efs		flags=backup=1;display="EFS"
/sec_efs      ext4		/dev/block/bootdevice/by-name/sec_efs		flags=backup=1;display="Sec EFS"

/keydata         ext4   /dev/block/bootdevice/by-name/keydata                   flags=display="keydata";wipeingui
/keyrefuge      ext4   /dev/block/bootdevice/by-name/keyrefuge                   flags=display="keyrefuge";wipeingui

/mnt/vendor/persist	ext4		/dev/block/bootdevice/by-name/persist		flags=fsflags=ro;display="Persist"

/omr		ext4		/dev/block/bootdevice/by-name/omr		flags=wipeingui;display="Omr"
/optics		ext4		/dev/block/bootdevice/by-name/optics		flags=wipeingui;display="Optics"
/prism		ext4		/dev/block/bootdevice/by-name/prism		flags=wipeingui;display="Prism"
/omr_image	emmc		/dev/block/bootdevice/by-name/omr		flags=backup=1;flashimg=1;display="Omr Image"
/optics_image	emmc		/dev/block/bootdevice/by-name/optics		flags=backup=1;flashimg=1;display="Optics Image"
/prism_image	emmc		/dev/block/bootdevice/by-name/prism		flags=backup=1;flashimg=1;display="Prism Image"

# Removable storage
/external_sd	auto		/dev/block/mmcblk0p1	/dev/block/mmcblk0	flags=display="Micro SDcard";storage;wipeingui;removable
/usb-otg	auto		/dev/block/sde1		/dev/block/sde1		flags=display="USB-OTG";storage;wipeingui;removable
